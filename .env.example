# Porta para executar a aplicação, o padrão é 3000
PORT=4010

# Banco de dados Supabase. A chave de serviço deve ficar exclusivamente no servidor
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEYS=

# Conta administradora inicial
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo aleatório exclusivo para assinar sessões, com pelo menos 32 caracteres
AUTH_SESSION_SECRET=

# Origem HTTPS do site hospedado
SITE_URL=http://localhost:4010/
